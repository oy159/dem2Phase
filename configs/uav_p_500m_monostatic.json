{
  "schema_version": 1,
  "name": "uav_p_500m_monostatic",
  "dataset": {
    "dem_directory": "data/dem",
    "split_manifest": "configs/dem_split_manifest.csv",
    "require_split_assignment": true,
    "output_directory": "data/pilot_dataset_uav_p_500m_phase4",
    "source_dem_pixel_spacing_m": 30,
    "generation": {
      "patches_per_dem": 32,
      "patch_size": 256,
      "n_precomp_scales": 3,
      "interp_scale_range": [2, 4],
      "rng_seed": 42,
      "max_wrap_count": 40,
      "void_fraction_threshold": 0.05
    },
    "landcover": {
      "enabled": true,
      "aligned_file": "data/landcover/ALPSMLC30_N027E085_DSM_worldcover2021_aligned.mat",
      "aligned_directory": "data/landcover",
      "aligned_suffix": "_worldcover2021_aligned.mat",
      "missing_policy": "error",
      "source": "ESA WorldCover 10m 2021 v200",
      "profile": "initial_pband_singlepass_v1_unvalidated",
      "unknown_factor": 1.0,
      "class_codes": [10, 20, 30, 40, 50, 60, 70, 80, 90, 95, 100],
      "coherence_factors": [0.85, 0.90, 0.97, 0.90, 0.85, 1.00, 0.75, 0.08, 0.65, 0.65, 0.90],
      "sampling": {
        "enabled": true,
        "priority_codes": [80, 50, 90, 40],
        "minimum_fraction": [0.01, 0.05, 0.01, 0.30],
        "acceptance_multiplier": [3.0, 1.7, 3.0, 1.2]
      }
    },
    "storage": {
      "mode": "grouped_mat",
      "write_legacy_per_edge": false,
      "numeric_type": "single"
    },
    "terrain_sampling": {
      "mode": "weighted",
      "max_attempts_factor": 12,
      "acceptance_probability": {
        "flat": 0.35,
        "rolling": 0.7,
        "steep": 1.0,
        "geometry_hazard": 1.0
      }
    }
  },
  "radar": {
    "center_frequency_hz": 500000000,
    "bandwidth_hz": 200000000,
    "prf_hz": 1000,
    "speed_mps": 20
  },
  "geometry": {
    "altitude_m": 500,
    "incidence_angle_deg": 45,
    "look_azimuth_deg": 90,
    "slant_range_m": 707.1067811865476
  },
  "coherence": {
    "model": "terrain_aware",
    "baseline_decay_model": "critical_baseline",
    "terrain_normalization_model": "absolute_scales",
    "min": 0.01,
    "max": 0.95,
    "decay_alpha": 0.35,
    "slope_weight": 0.9,
    "roughness_weight": 0.8,
    "curvature_weight": 0.35,
    "slope_scale_deg": 45,
    "roughness_scale_m": 71.823859,
    "curvature_scale_per_m": 0.006326427,
    "scale_calibration_source": "ALPSMLC30_N027E085_DSM.tif; 96 patches; P95; seed 20260910",
    "shared_residual_std": 0.12,
    "edge_residual_std": 0.08,
    "residual_scale_px": 24
  },
  "noise": {
    "model": "complex_slc_nodes",
    "node_snr_db_range": [15, 30],
    "multilook_window": 7,
    "save_node_slc": false
  },
  "phase4_errors": {
    "enabled": true,
    "profile": "pband_uav_nominal_v1_unvalidated",
    "synchronization": {
      "phase_bias_std_rad": 0.02,
      "linear_drift_std_rad": 0.03,
      "random_walk_std_rad_per_row": 0.002,
      "jump_probability_per_node": 0.1,
      "jump_std_rad": 0.15
    },
    "trajectory": {
      "los_bias_std_m": 0.01,
      "los_drift_std_m": 0.005,
      "vibration_std_m": 0.002,
      "vibration_cycles_range": [1, 5]
    },
    "attitude": {
      "roll_std_deg": 0.02,
      "pitch_std_deg": 0.02
    },
    "coregistration": {
      "range_shift_std_px": 0.05,
      "azimuth_shift_std_px": 0.05,
      "linear_drift_std_px": 0.02
    }
  },
  "phase4_failures": {
    "enabled": false,
    "profile": "compound_failure_v1_unvalidated",
    "force_secondary_uav_dropout": true,
    "always_include_shortest": true,
    "always_include_longest": true,
    "low_coherence_threshold": 0.25,
    "low_coherence_min_fraction": 0.05,
    "sync_jump_min_abs_rad": 0.1
  },
  "interferometry": {
    "measurement_mode": "monostatic_pair",
    "phase_path_multiplicity": 2,
    "num_uavs": 5,
    "edge_mode": "star",
    "reference_uav": 1,
    "baseline_perp_m": [0.75, 1.2, 1.8, 3.0],
    "allowed_baseline_perp_m": [0.5, 3.0],
    "target_ambiguity_height_m": [200, 125, 83.3333333333, 50],
    "edge_sampling": {
      "enabled": true,
      "min_active_edges": 2,
      "max_active_edges": 4,
      "always_include_shortest": true
    }
  }
}
